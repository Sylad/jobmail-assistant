# ─── IMAP source ──────────────────────────────────────────────────
# Leave IMAP_HOST empty to skip IMAP and run on mock data only.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_FETCH_LIMIT=50

# ─── Local DB ─────────────────────────────────────────────────────
DB_PATH=./data/jobmail.db

# ─── LLM provider for extraction (job-related mails only) ─────────
# mock | ollama | claude | openai
LLM_PROVIDER=mock

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (stub)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Profil ciblé pour le scoring /10 ─────────────────────────────
TARGET_PROFILE="Java senior, GeoServer, OpenLayers, Kubernetes, PostGIS, Spring, Docker"

# ─── Web ──────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8765
